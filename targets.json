{
  "roots": {
    "agents": "~/.agents/skills",
    "codex": "~/.codex/skills",
    "claude": "~/.claude/skills"
  },
  "skills": {
    "spec-plan": ["agents", "codex", "claude"],
    "spec-analyze": ["agents", "codex", "claude"],
    "spec-next": ["agents", "codex", "claude"],
    "spec-audit": ["agents", "codex", "claude"],
    "project-init": ["agents", "codex", "claude"],
    "context-resume": ["agents", "codex", "claude"],
    "work-status": ["agents", "codex", "claude"],
    "ship": ["agents", "codex", "claude"],
    "ui-check": ["agents", "codex", "claude"],
    "debug-profile": ["agents", "codex", "claude"],
    "evidence-research": ["agents", "codex", "claude"],
    "agent-quality": ["agents", "codex", "claude"],
    "relay": ["agents", "codex", "claude"],
    "blockers": ["agents", "codex", "claude"],
    "report": ["agents", "codex", "claude"],
    "health": ["agents", "codex", "claude"],
